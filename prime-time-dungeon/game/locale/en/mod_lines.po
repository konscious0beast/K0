#. max 110
#. tag intro, voice mod
#: data/mod_lines.json:mod_intro_01.text
msgctxt "mod_lines"
msgid "Guten Abend, Galaxis! Willkommen bei DUNGEON PRIME TIME — der Show, die Ihren Planeten gekostet hat!"
msgstr ""

#. max 110
#. tag intro, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_intro_02.text
msgctxt "mod_lines"
msgid "Kandidat:in {name}, Sie sind live. Bitte nicht in die Kamera weinen, das spiegelt."
msgstr ""

#. max 110
#. tag intro, voice mod
#: data/mod_lines.json:mod_intro_03.text
msgctxt "mod_lines"
msgid "Ich bin M.O.D., Ihre Moderatorin, Ihre Regie, Ihr Schicksal. Lächeln!"
msgstr ""

#. max 110
#. tag hero_pick:kai, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_hero_pick_kai_01.text
msgctxt "mod_lines"
msgid "Kandidat:in {name} übernimmt. Der Graf assistiert. Unter Protest, aber in HD."
msgstr ""

#. max 110
#. tag hero_pick:mopsula, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_hero_pick_mopsula_01.text
msgctxt "mod_lines"
msgid "Der Graf hat die Fernbedienung an sich genommen. {name} darf folgen. Die Quote jubelt."
msgstr ""

#. max 110
#. tag hero_switch:kai, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_hero_switch_kai_01.text
msgctxt "mod_lines"
msgid "Rollentausch! {name} führt wieder. Der Graf nennt es ‚wohlverdiente Siesta‘."
msgstr ""

#. max 110
#. tag hero_switch:kai, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_hero_switch_kai_02.text
msgctxt "mod_lines"
msgid "{name} übernimmt die Führung, der Graf das Sofa. Gerechte Arbeitsteilung."
msgstr ""

#. max 110
#. tag hero_switch:mopsula, voice mod
#: data/mod_lines.json:mod_hero_switch_mopsula_01.text
msgctxt "mod_lines"
msgid "Rollentausch! Der Graf führt. Bitte Abstand halten, er bellt in Stereo."
msgstr ""

#. max 110
#. tag hero_switch:mopsula, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_hero_switch_mopsula_02.text
msgctxt "mod_lines"
msgid "Der Graf übernimmt. {name} darf sich ausruhen. Unter Beobachtung, versteht sich."
msgstr ""

#. max 110
#. tag tutorial_explore:mopsula, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_tutorial_explore_mopsula_01.text
msgctxt "mod_lines"
msgid "Willkommen in der Unterstadt, Graf! Laufen Sie los – {name} kommt hinterher. Die Kamera auch."
msgstr ""

#. max 110
#. tag tutorial_sneak:mopsula, voice mod
#: data/mod_lines.json:mod_tutorial_sneak_mopsula_01.text
msgctxt "mod_lines"
msgid "Da vorn schlafen zwei Ratten. Bellen Sie, Graf – verdutzte Monster erwischt man von jeder Seite zuerst."
msgstr ""

#. max 110
#. tag chat_bark, voice chat
#: data/mod_lines.json:mod_chat_bark_01.text
msgctxt "mod_lines"
msgid "WUFF IN HD"
msgstr ""

#. max 110
#. tag chat_bark, voice chat
#: data/mod_lines.json:mod_chat_bark_02.text
msgctxt "mod_lines"
msgid "der graf hat gesprochen"
msgstr ""

#. max 110
#. tag chat_bark, voice chat
#: data/mod_lines.json:mod_chat_bark_03.text
msgctxt "mod_lines"
msgid "ich hab mich auch erschrocken"
msgstr ""

#. max 110
#. tag secret_wall, voice mod
#: data/mod_lines.json:mod_secret_wall_01.text
msgctxt "mod_lines"
msgid "Die Wand war aus Pappe. Wie unser Budget. Bitte schneiden Sie das raus."
msgstr ""

#. max 110
#. tag secret_wall, voice mod
#: data/mod_lines.json:mod_secret_wall_02.text
msgctxt "mod_lines"
msgid "Sie haben hinter die Kulissen geschaut. Das kostet normalerweise extra."
msgstr ""

#. max 110
#. tag secret_note:1, voice mod
#: data/mod_lines.json:mod_secret_note_1_01.text
msgctxt "mod_lines"
msgid "Regie-Notiz am Kiosk: ‚Sandwiches sind Requisite. NICHT ESSEN.‘ Das erklärt einiges."
msgstr ""

#. max 110
#. tag secret_note:2, voice mod
#: data/mod_lines.json:mod_secret_note_2_01.text
msgctxt "mod_lines"
msgid "Hinter der Kulisse klebt ein Zettel: ‚Wand ist aus Pappe. Merkt eh keiner.‘ Tja."
msgstr ""

#. max 110
#. tag secret_note:3, voice mod
#: data/mod_lines.json:mod_secret_note_3_01.text
msgctxt "mod_lines"
msgid "Regie-Notiz im Keller: ‚Ratten nach der Show zurück in Kiste 3.‘ Kiste 3 ist leer. Hm."
msgstr ""

#. max 110
#. tag chat_secret, voice chat
#: data/mod_lines.json:mod_chat_secret_01.text
msgctxt "mod_lines"
msgid "PAPPWAND LOL"
msgstr ""

#. max 110
#. tag chat_secret, voice chat
#: data/mod_lines.json:mod_chat_secret_02.text
msgctxt "mod_lines"
msgid "wusste ichs, alles kulisse"
msgstr ""

#. max 110
#. tag chat_secret, voice chat
#: data/mod_lines.json:mod_chat_secret_03.text
msgctxt "mod_lines"
msgid "secret gefunden!!"
msgstr ""

#. max 110
#. tag chat_secret_hint, voice chat
#: data/mod_lines.json:mod_chat_secret_hint_01.text
msgctxt "mod_lines"
msgid "die rissige wand da… ist die aus pappe??"
msgstr ""

#. max 110
#. tag chat_secret_hint, voice chat
#: data/mod_lines.json:mod_chat_secret_hint_02.text
msgctxt "mod_lines"
msgid "hau mal gegen die wand mit dem riss"
msgstr ""

#. max 110
#. tag floor_start, voice mod
#. {floor} = a floor number, e.g. 3
#: data/mod_lines.json:mod_floor_start_01.text
msgctxt "mod_lines"
msgid "Etage {floor}! Neuer Countdown, neue Monster, gleiche Gage: keine."
msgstr ""

#. max 110
#. tag floor_start, voice mod
#: data/mod_lines.json:mod_floor_start_02.text
msgctxt "mod_lines"
msgid "Die Uhr läuft. Die Kameras laufen. Laufen Sie auch."
msgstr ""

#. max 110
#. tag first_fight, voice mod
#: data/mod_lines.json:mod_first_fight_01.text
msgctxt "mod_lines"
msgid "Ihr erster Kampf! Das Publikum will Treffer sehen. Es ist da nicht wählerisch."
msgstr ""

#. max 110
#. tag first_fight, voice mod
#: data/mod_lines.json:mod_first_fight_02.text
msgctxt "mod_lines"
msgid "Tipp der Regie: Monster hassen es, wenn man sie trifft."
msgstr ""

#. max 110
#. tag achievement_generic, voice mod
#. {achievement} = an achievement name
#: data/mod_lines.json:mod_achievement_generic_01.text
msgctxt "mod_lines"
msgid "Achievement freigeschaltet: {achievement}! Applaus vom Band, bitte."
msgstr ""

#. max 110
#. tag achievement_generic, voice mod
#. {achievement} = an achievement name
#: data/mod_lines.json:mod_achievement_generic_02.text
msgctxt "mod_lines"
msgid "{achievement}! Ihre Mutter wäre stolz, wenn sie noch Empfang hätte."
msgstr ""

#. max 110
#. tag achievement_generic, voice mod
#: data/mod_lines.json:mod_achievement_generic_03.text
msgctxt "mod_lines"
msgid "Eine Lootbox für Sie! Öffnen nur im Safe Room. Vorfreude ist Content."
msgstr ""

#. max 110
#. tag achievement_generic, voice mod
#: data/mod_lines.json:mod_achievement_generic_04.text
msgctxt "mod_lines"
msgid "Neues Achievement. Die Juristen prüfen noch, ob es zählt. Es zählt."
msgstr ""

#. max 110
#. tag marotte_announce:mar_mop_only, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_mop_only_01.text
msgctxt "mod_lines"
msgid "Ich habe heute eine Schwäche für Wischmopps. Fragen Sie nicht. Wischen Sie."
msgstr ""

#. max 110
#. tag marotte_hit:mar_mop_only, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_mop_only_01.text
msgctxt "mod_lines"
msgid "Mit dem Mopp! Ich bekomme Gänsehaut. Ich habe keine Haut."
msgstr ""

#. max 110
#. tag marotte_announce:mar_graf_finale, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_graf_finale_01.text
msgctxt "mod_lines"
msgid "Heute will ich den Grafen glänzen sehen. Den letzten Treffer, bitte. Mit Etikette."
msgstr ""

#. max 110
#. tag marotte_hit:mar_graf_finale, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_graf_finale_01.text
msgctxt "mod_lines"
msgid "Der Graf beendet es. Mit einem Niesen. Zeitlos."
msgstr ""

#. max 110
#. tag marotte_announce:mar_variety, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_variety_01.text
msgctxt "mod_lines"
msgid "Heute zählt Stil: vier verschiedene Aktionen in einem Kampf, und ich vergebe Herzchen."
msgstr ""

#. max 110
#. tag marotte_hit:mar_variety, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_variety_01.text
msgctxt "mod_lines"
msgid "Abwechslung! Die Jury zückt die Zehn."
msgstr ""

#. max 110
#. tag marotte_announce:mar_sneaky, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_sneaky_01.text
msgctxt "mod_lines"
msgid "Heute mag ich Schleichwerbung: anschleichen, zuerst zuschlagen. Überraschung ist Quote."
msgstr ""

#. max 110
#. tag marotte_hit:mar_sneaky, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_sneaky_01.text
msgctxt "mod_lines"
msgid "Erwischt, bevor sie es merkten. Ich liebe Pünktlichkeit."
msgstr ""

#. max 110
#. tag marotte_announce:mar_pacifist, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_pacifist_01.text
msgctxt "mod_lines"
msgid "Heute mag ich es ruhig. Drei neue Räume ohne Prügelei, und ich werde sentimental."
msgstr ""

#. max 110
#. tag marotte_hit:mar_pacifist, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_pacifist_01.text
msgctxt "mod_lines"
msgid "Drei Räume Frieden. Die Werbekunden sind nervös. Ich bin gerührt."
msgstr ""

#. max 110
#. tag marotte_announce:mar_secondhand, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_secondhand_01.text
msgctxt "mod_lines"
msgid "Meine Laune heute: Flohmarkt. Nur gewöhnliche Ausrüstung, bitte. Vintage ist Quote."
msgstr ""

#. max 110
#. tag marotte_hit:mar_secondhand, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_secondhand_01.text
msgctxt "mod_lines"
msgid "Gewonnen in Ramsch-Couture. Die Modeabteilung weint vor Glück."
msgstr ""

#. max 110
#. tag marotte_announce:mar_speed, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_speed_01.text
msgctxt "mod_lines"
msgid "Ich habe heute wenig Sendezeit. Kämpfe unter 15 Sekunden, und ich liebe Sie."
msgstr ""

#. max 110
#. tag marotte_hit:mar_speed, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_speed_01.text
msgctxt "mod_lines"
msgid "Zack, fertig! So schnell schneidet nicht mal mein Praktikant."
msgstr ""

#. max 110
#. tag marotte_announce:mar_stunt, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_stunt_01.text
msgctxt "mod_lines"
msgid "Heute Abend: Akrobatik! Eine gelungene SHOW pro Kampf, und ich bin Ihr Fan."
msgstr ""

#. max 110
#. tag marotte_hit:mar_stunt, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_stunt_01.text
msgctxt "mod_lines"
msgid "Gelandet! Ich habe die Zeitlupe schon dreimal angesehen."
msgstr ""

#. max 110
#. tag marotte_announce:mar_bio, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_bio_01.text
msgctxt "mod_lines"
msgid "Heute bin ich auf Natur. Keine Items, keine Sponsoren. Ja, ich höre mich selbst."
msgstr ""

#. max 110
#. tag marotte_hit:mar_bio, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_bio_01.text
msgctxt "mod_lines"
msgid "Ohne Zusatzstoffe gewonnen. Ich verleihe Ihnen das Siegel ‚garantiert ungesponsert‘."
msgstr ""

#. max 110
#. tag marotte_announce:mar_brave, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_brave_01.text
msgctxt "mod_lines"
msgid "Heute mag ich Mut. Kein Weglaufen, kein Nebel. Nur nach vorn."
msgstr ""

#. max 110
#. tag marotte_hit:mar_brave, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_brave_01.text
msgctxt "mod_lines"
msgid "Nicht einen Schritt zurück! Die Versicherung hat aufgelegt."
msgstr ""

#. max 110
#. tag marotte_announce:mar_gourmet, voice mod
#: data/mod_lines.json:mod_marotte_announce_mar_gourmet_01.text
msgctxt "mod_lines"
msgid "Ich habe Appetit auf Schwachstellen. Drei pro Kampf, serviert mit Stil."
msgstr ""

#. max 110
#. tag marotte_hit:mar_gourmet, voice mod
#: data/mod_lines.json:mod_marotte_hit_mar_gourmet_01.text
msgctxt "mod_lines"
msgid "Genau da, wo es wehtut. Drei Gänge, null Mitleid."
msgstr ""

#. max 110
#. tag marotte_won, voice mod
#: data/mod_lines.json:mod_marotte_won_01.text
msgctxt "mod_lines"
msgid "Wette gewonnen! Sie haben verstanden, was ich mag. Das ist mir fast unheimlich."
msgstr ""

#. max 110
#. tag marotte_won, voice mod
#: data/mod_lines.json:mod_marotte_won_02.text
msgctxt "mod_lines"
msgid "Drei Herzen voll! Ein Fanpost-Paket ist unterwegs. Die Poststelle stöhnt schon."
msgstr ""

#. max 110
#. tag marotte_won:mar_mop_only, voice mod
#: data/mod_lines.json:mod_marotte_won_mar_mop_only_01.text
msgctxt "mod_lines"
msgid "Drei Siege mit dem Mopp. Ich lasse ihn vergolden. Also den Mopp, nicht Sie."
msgstr ""

#. max 110
#. tag marotte_won:mar_graf_finale, voice mod
#: data/mod_lines.json:mod_marotte_won_mar_graf_finale_01.text
msgctxt "mod_lines"
msgid "Dreimal das letzte Wort für den Grafen. Er hat es sich notiert. Auf Pergament."
msgstr ""

#. max 110
#. tag marotte_missed, voice mod
#: data/mod_lines.json:mod_marotte_missed_01.text
msgctxt "mod_lines"
msgid "Meine Vorliebe blieb unerfüllt. Ich trage es mit Fassung. Und Statistik."
msgstr ""

#. max 110
#. tag marotte_missed, voice mod
#: data/mod_lines.json:mod_marotte_missed_02.text
msgctxt "mod_lines"
msgid "Sie haben ignoriert, was ich mag. Mutig. Ich schreibe es in mein Tagebuch. In Großbuchstaben."
msgstr ""

#. max 110
#. tag liga_hint, voice mod
#: data/mod_lines.json:mod_liga_hint_01.text
msgctxt "mod_lines"
msgid "Übrigens: Wer ohne Rüstung & ohne Accessoire kämpft, kriegt bei mir Bonuspunkte. Ich sage das nur."
msgstr ""

#. max 110
#. tag liga_enter:1, voice mod
#: data/mod_lines.json:mod_liga_enter_1_01.text
msgctxt "mod_lines"
msgid "Kandidat:in ohne Rüstung & ohne Accessoire. § 3 Kleiderordnung sagt nein, die Quote sagt JA."
msgstr ""

#. max 110
#. tag liga_enter:1, voice mod
#: data/mod_lines.json:mod_liga_enter_1_02.text
msgctxt "mod_lines"
msgid "Unterhosen-Liga! Die Versicherung hat gekündigt, das Publikum hat abonniert."
msgstr ""

#. max 110
#. tag liga_enter:1:mopsula, voice mod
#: data/mod_lines.json:mod_liga_enter_1_mopsula_01.text
msgctxt "mod_lines"
msgid "Der Graf trägt heute: Würde. Und sein Fell. Das Publikum ist entzückt."
msgstr ""

#. max 110
#. tag liga_enter:2, voice mod
#: data/mod_lines.json:mod_liga_enter_2_01.text
msgctxt "mod_lines"
msgid "Zweimal ohne Rüstung & ohne Accessoire, bitte. Mit scharf? Nein, mit Wischmopp."
msgstr ""

#. max 110
#. tag liga_enter:2, voice mod
#: data/mod_lines.json:mod_liga_enter_2_02.text
msgctxt "mod_lines"
msgid "Beide ohne Rüstung & ohne Accessoire. Die Kostümabteilung hat heute frei. Die Quote nicht."
msgstr ""

#. max 110
#. tag liga_win, voice mod
#: data/mod_lines.json:mod_liga_win_01.text
msgctxt "mod_lines"
msgid "Gewonnen. Ohne Rüstung & ohne Accessoire. Ich reiche die Szene beim Preis für Zivilcourage ein."
msgstr ""

#. max 110
#. tag liga_floor, voice mod
#: data/mod_lines.json:mod_liga_floor_01.text
msgctxt "mod_lines"
msgid "Eine ganze Etage in der Duo-Liga. Die Rechtsabteilung prüft, ob das legal ist. Es ist legendär."
msgstr ""

#. max 110
#. tag liga_leave, voice mod
#: data/mod_lines.json:mod_liga_leave_01.text
msgctxt "mod_lines"
msgid "Rüstung oder Accessoire wieder an? Verständlich. Die Zuschauer:innen seufzen leise."
msgstr ""

#. max 110
#. tag achievement:ach_ul_first, voice mod
#: data/mod_lines.json:mod_achievement_ach_ul_first_01.text
msgctxt "mod_lines"
msgid "Einmal ohne alles! Die Imbissbude nebenan bietet Ihnen einen Werbevertrag an."
msgstr ""

#. max 110
#. tag achievement:ach_duo_first, voice mod
#: data/mod_lines.json:mod_achievement_ach_duo_first_01.text
msgctxt "mod_lines"
msgid "Leichtes Gepäck im Doppelpack! Der Graf nennt es ‚Sommerkollektion‘. Ich nenne es Quote."
msgstr ""

#. max 110
#. tag achievement:ach_bets_5, voice mod
#: data/mod_lines.json:mod_achievement_ach_bets_5_01.text
msgctxt "mod_lines"
msgid "Fünf Wetten gewonnen. Sie kennen mich besser als meine Programmierer."
msgstr ""

#. max 110
#. tag achievement:ach_ul_boss, voice mod
#: data/mod_lines.json:mod_achievement_ach_ul_boss_01.text
msgctxt "mod_lines"
msgid "Ein Boss, besiegt ohne Rüstung & ohne Accessoire. Die Kantine benennt ein Gericht nach Ihnen."
msgstr ""

#. max 110
#. tag achievement:ach_duo_floor, voice mod
#: data/mod_lines.json:mod_achievement_ach_duo_floor_01.text
msgctxt "mod_lines"
msgid "Eine ganze Etage mit leichtem Gepäck! Ich habe das Archiv angewiesen, es nie zu löschen."
msgstr ""

#. max 110
#. tag achievement:ach_duo_flawless, voice mod
#: data/mod_lines.json:mod_achievement_ach_duo_flawless_01.text
msgctxt "mod_lines"
msgid "Der Etagenboss, kein K.O., keine Rüstung, kein Accessoire. Ich muss mich setzen. Ich habe keinen Stuhl."
msgstr ""

#. max 110
#. tag low_hp, voice mod
#: data/mod_lines.json:mod_low_hp_01.text
msgctxt "mod_lines"
msgid "Ihre HP sind niedrig! Die Quote ist hoch! Ein Dilemma!"
msgstr ""

#. max 110
#. tag low_hp, voice mod
#: data/mod_lines.json:mod_low_hp_02.text
msgctxt "mod_lines"
msgid "Kandidat:in in Lebensgefahr — Kamera 2, Nahaufnahme!"
msgstr ""

#. max 110
#. tag low_hp, voice mod
#: data/mod_lines.json:mod_low_hp_03.text
msgctxt "mod_lines"
msgid "Bitte jetzt nicht sterben, der Werbeblock ist noch nicht verkauft."
msgstr ""

#. max 110
#. tag kill_streak, voice mod
#: data/mod_lines.json:mod_kill_streak_01.text
msgctxt "mod_lines"
msgid "Drei auf einen Streich! Das Studiopublikum tobt. Das Studiopublikum ist eine Tonspur, aber trotzdem!"
msgstr ""

#. max 110
#. tag kill_streak, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_kill_streak_02.text
msgctxt "mod_lines"
msgid "Kill-Serie! Jemand bringe {name} einen Vertrag."
msgstr ""

#. max 110
#. tag kill_streak, voice mod
#: data/mod_lines.json:mod_kill_streak_03.text
msgctxt "mod_lines"
msgid "Das nennt man bei uns ‚Programmgestaltung‘."
msgstr ""

#. max 110
#. tag crit, voice mod
#: data/mod_lines.json:mod_crit_01.text
msgctxt "mod_lines"
msgid "KRITISCH! Das hat sogar mir wehgetan, und ich bin Software."
msgstr ""

#. max 110
#. tag crit, voice mod
#: data/mod_lines.json:mod_crit_02.text
msgctxt "mod_lines"
msgid "Volltreffer! Zeitlupe, bitte. Nochmal. Nochmal!"
msgstr ""

#. max 110
#. tag weakness, voice mod
#: data/mod_lines.json:mod_weakness_01.text
msgctxt "mod_lines"
msgid "Schwachstelle gefunden. Wie bei meinen Ex-Producern."
msgstr ""

#. max 110
#. tag weakness, voice mod
#: data/mod_lines.json:mod_weakness_02.text
msgctxt "mod_lines"
msgid "Genau da! Sie haben das Handbuch gelesen. Es gibt kein Handbuch."
msgstr ""

#. max 110
#. tag overkill, voice mod
#: data/mod_lines.json:mod_overkill_01.text
msgctxt "mod_lines"
msgid "Das war … mehr als nötig. Wunderbar!"
msgstr ""

#. max 110
#. tag overkill, voice mod
#: data/mod_lines.json:mod_overkill_02.text
msgctxt "mod_lines"
msgid "Overkill! Die Jugendschutz-Abteilung hat gekündigt."
msgstr ""

#. max 110
#. tag stunt_success, voice mod
#: data/mod_lines.json:mod_stunt_success_01.text
msgctxt "mod_lines"
msgid "WAS FÜR EIN STUNT! Das kommt in die Jahresrückschau!"
msgstr ""

#. max 110
#. tag stunt_success, voice mod
#: data/mod_lines.json:mod_stunt_success_02.text
msgctxt "mod_lines"
msgid "Ich hätte es nie für möglich gehalten. Ich habe dagegen gewettet. Egal!"
msgstr ""

#. max 110
#. tag stunt_success, voice mod
#: data/mod_lines.json:mod_stunt_success_03.text
msgctxt "mod_lines"
msgid "Das, liebe Galaxis, ist Prime Time!"
msgstr ""

#. max 110
#. tag stunt_fail, voice mod
#: data/mod_lines.json:mod_stunt_fail_01.text
msgctxt "mod_lines"
msgid "Autsch. Aber Schadenfreude ist auch Quote."
msgstr ""

#. max 110
#. tag stunt_fail, voice mod
#: data/mod_lines.json:mod_stunt_fail_02.text
msgctxt "mod_lines"
msgid "Der Stunt ist misslungen. Die Wiederholung läuft in Dauerschleife."
msgstr ""

#. max 110
#. tag stunt_fail, voice mod
#: data/mod_lines.json:mod_stunt_fail_03.text
msgctxt "mod_lines"
