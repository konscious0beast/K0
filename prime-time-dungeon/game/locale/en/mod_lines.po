#. max 110
#. tag talent_pick, voice mod
#: data/mod_lines.json:mod_talent_pick_01.text
msgctxt "mod_lines"
msgid "Neues Talent! Die Regie nennt es Entwicklung. Ich nenne es: mehr Material."
msgstr ""

#. max 110
#. tag talent_pick, voice mod
#: data/mod_lines.json:mod_talent_pick_02.text
msgctxt "mod_lines"
msgid "Notiert. Das Publikum liebt Figuren mit Entwicklung. Und mit Wischmopp."
