#. max 110
#. tag flee, voice mod
#: data/mod_lines.json:mod_flee_02.text
msgctxt "mod_lines"
msgid "Und weg sind sie. Die Kamera bleibt beim Monster. Es wirkt einsam."
msgstr ""

#. max 110
#. tag flee, voice mod
#: data/mod_lines.json:mod_flee_03.text
msgctxt "mod_lines"
msgid "Rückzug notiert. Die Zuschauer auch. Sie entfolgen."
msgstr ""

#. max 110
#. tag flee_fail, voice mod
#: data/mod_lines.json:mod_flee_fail_01.text
msgctxt "mod_lines"
msgid "Fluchtversuch gescheitert. Das Monster hat Sie freundlich zurückgebeten."
msgstr ""

#. max 110
#. tag flee_fail, voice mod
#: data/mod_lines.json:mod_flee_fail_02.text
msgctxt "mod_lines"
msgid "Nö. Die Tür ist dekorativ."
msgstr ""

#. max 110
#. tag sponsor_gift, voice mod
#. {sponsor} = a sponsor name
#: data/mod_lines.json:mod_sponsor_gift_01.text
msgctxt "mod_lines"
msgid "Dieser Moment wird Ihnen präsentiert von {sponsor}!"
msgstr ""

#. max 110
#. tag sponsor_gift, voice mod
#. {sponsor} = a sponsor name
#: data/mod_lines.json:mod_sponsor_gift_02.text
msgctxt "mod_lines"
msgid "Ein Geschenk von {sponsor}! Bitte das Logo in die Kamera halten."
msgstr ""

#. max 110
#. tag sponsor_gift, voice mod
#. {sponsor} = a sponsor name
#: data/mod_lines.json:mod_sponsor_gift_03.text
msgctxt "mod_lines"
msgid "Die Zuschauer lieben Sie, also liebt {sponsor} Sie. Vorläufig."
msgstr ""

#. max 110
#. tag timer_warn_300, voice mod
#: data/mod_lines.json:mod_timer_warn_300_01.text
msgctxt "mod_lines"
msgid "Noch fünf Minuten! Die Etage bricht bald zusammen. Wir haben Popcorn."
msgstr ""

#. max 110
#. tag timer_warn_300, voice mod
#: data/mod_lines.json:mod_timer_warn_300_02.text
msgctxt "mod_lines"
msgid "Fünf Minuten bis zum Einsturz. Treppe suchen wäre jetzt ein Trend."
msgstr ""

#. max 110
#. tag timer_warn_300, voice mod
#: data/mod_lines.json:mod_timer_warn_300_03.text
msgctxt "mod_lines"
msgid "Achtung: Die Unterstadt schließt in fünf Minuten. Bitte zügig zum Ausgang. Oder nicht. Quote!"
msgstr ""

#. max 110
#. tag timer_warn_60, voice mod
#: data/mod_lines.json:mod_timer_warn_60_01.text
msgctxt "mod_lines"
msgid "EINE MINUTE! Laufen Sie! LAUFEN SIE!"
msgstr ""

#. max 110
#. tag timer_warn_60, voice mod
#: data/mod_lines.json:mod_timer_warn_60_02.text
msgctxt "mod_lines"
msgid "Sechzig Sekunden! Ich habe die Dramamusik extra laut gestellt."
