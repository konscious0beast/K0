#. tag boss_phase:enm_boss_rattenkoenigin:3, voice mod
#: data/mod_lines.json:mod_boss_phase_enm_boss_rattenkoenigin_3_01.text
msgctxt "mod_lines"
msgid "Der Zug ist entgleist! Die Königin ist wütend! Ich bin begeistert!"
msgstr ""

#. max 110
#. tag boss_defeated, voice mod
#: data/mod_lines.json:mod_boss_defeated_01.text
msgctxt "mod_lines"
msgid "Boss besiegt! Die Einschaltquote macht gerade einen Handstand."
msgstr ""

#. max 110
#. tag boss_defeated, voice mod
#: data/mod_lines.json:mod_boss_defeated_02.text
msgctxt "mod_lines"
