#. max 110
#. tag talent_pick:mopsula, voice mod
#: data/mod_lines.json:mod_talent_pick_mopsula_01.text
msgctxt "mod_lines"
msgid "Der Graf lernt dazu. Er bestreitet, dass es etwas zu lernen gab."
msgstr ""

#. max 110
#. tag talent_pick:mopsula, voice mod
#: data/mod_lines.json:mod_talent_pick_mopsula_02.text
msgctxt "mod_lines"
