#. max 110
#. tag casting_open, voice mod
#: data/mod_lines.json:mod_casting_open_01.text
msgctxt "mod_lines"
msgid "Recall! Wer wollen Sie sein? Und was wollen Sie können? Die Jury bin ich."
msgstr ""

