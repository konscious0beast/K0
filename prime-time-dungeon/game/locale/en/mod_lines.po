msgstr ""

#. max 110
#. tag level_up, voice mod
#: data/mod_lines.json:mod_level_up_02.text
msgctxt "mod_lines"
msgid "Stufenaufstieg! Mehr HP, mehr MP, gleich wenig Gage."
msgstr ""

#. max 110
#. tag talent_show_open, voice mod
#: data/mod_lines.json:mod_talent_show_open_01.text
msgctxt "mod_lines"
