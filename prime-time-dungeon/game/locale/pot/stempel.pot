#. max 110
#. tag sd_explain, voice mod
#: data/stempel/lines.json:sdl_explain_01.text
msgctxt "stempel.lines"
msgid "Stempelduell an Schalter 3! Lange Formulare, lange Wartezeit. Wer zuerst die Geduld verliert, verliert."
msgstr ""

#. max 110
#. tag sd_intro, voice mod
#: data/stempel/lines.json:sdl_intro_01.text
msgctxt "stempel.lines"
msgid "Willkommen bei STEMPELDUELL, der Spieleshow in meiner Show! Heute: Papier gegen Nerven."
msgstr ""

#. max 110
#. tag sd_intro, voice mod
#: data/stempel/lines.json:sdl_intro_02.text
msgctxt "stempel.lines"
msgid "Schalter 3 ist geöffnet. Ziehen Sie eine Nummer und lächeln Sie in Kamera 2."
msgstr ""

#. max 110
#. tag sd_intro, voice mod
#: data/stempel/lines.json:sdl_intro_03.text
msgctxt "stempel.lines"
msgid "STEMPELDUELL! Die einzige Show, in der Warten spannend ist. Behauptet jedenfalls die Werbeabteilung."
msgstr ""

#. max 110
#. tag sd_first_card, voice mod
#: data/stempel/lines.json:sdl_first_card_01.text
msgctxt "stempel.lines"
msgid "Eine Karte, ein Zug. Lange Formulare, lange Wartezeit. Wie im echten Leben, nur mit Kamera."
msgstr ""

#. max 110
#. tag sd_turn_player, voice mod
#: data/stempel/lines.json:sdl_turn_player_01.text
msgctxt "stempel.lines"
msgid "Nummer {ticket}, bitte. Sie sind dran."
msgstr ""

#. max 110
#. tag sd_turn_player, voice mod
#: data/stempel/lines.json:sdl_turn_player_02.text
msgctxt "stempel.lines"
msgid "Nummer {ticket} — Sie sind dran."
msgstr ""

#. max 110
#. tag sd_turn_opp, voice mod
#: data/stempel/lines.json:sdl_turn_opp_01.text
msgctxt "stempel.lines"
msgid "Nummer {ticket} — {opp} stempelt."
msgstr ""

#. max 110
#. tag sd_turn_opp, voice mod
#: data/stempel/lines.json:sdl_turn_opp_02.text
msgctxt "stempel.lines"
msgid "Nummer {ticket}: {opp} ist dran. Bitte nicht drängeln."
msgstr ""

#. max 110
#. tag sd_wiedervorlage, voice mod
#: data/stempel/lines.json:sdl_wiedervorlage_01.text
msgctxt "stempel.lines"
msgid "Wiedervorlage! Die Nummer rutscht nach hinten. Das Publikum liebt Verzögerungen. Ich auch."
msgstr ""

#. max 110
#. tag sd_wiedervorlage, voice mod
#: data/stempel/lines.json:sdl_wiedervorlage_02.text
msgctxt "stempel.lines"
msgid "Bitte noch einmal vorlegen! Drei Werktage später. Bis dahin senden wir Werbung."
msgstr ""

#. max 110
#. tag sd_abgeprallt, voice mod
#: data/stempel/lines.json:sdl_abgeprallt_01.text
msgctxt "stempel.lines"
msgid "Abgeprallt! Für Wiedervorlagen ist man hier schlicht nicht zuständig."
msgstr ""

#. max 110
#. tag sd_weak, voice mod
#: data/stempel/lines.json:sdl_weak_01.text
msgctxt "stempel.lines"
msgid "WUNDER PUNKT! Das ging mitten durch die Ablage."
msgstr ""

#. max 110
#. tag sd_weak, voice mod
#: data/stempel/lines.json:sdl_weak_02.text
msgctxt "stempel.lines"
msgid "Wunder Punkt getroffen! Da wellt sich das Papier."
msgstr ""

#. max 110
#. tag sd_resist, voice mod
#: data/stempel/lines.json:sdl_resist_01.text
msgctxt "stempel.lines"
msgid "Nicht zuständig! Der halbe Ärger landet bei der Poststelle."
msgstr ""

#. max 110
#. tag sd_resist, voice mod
#: data/stempel/lines.json:sdl_resist_02.text
msgctxt "stempel.lines"
msgid "Prallt halb ab. Falsche Abteilung, richtige Mühe."
msgstr ""

#. max 110
#. tag sd_chain, voice mod
#: data/stempel/lines.json:sdl_chain_01.text
msgctxt "stempel.lines"
msgid "Dreimal hintereinander dran! Das nennt man bei uns ‚Programmplanung‘."
msgstr ""

#. max 110
#. tag sd_chain, voice mod
#: data/stempel/lines.json:sdl_chain_02.text
msgctxt "stempel.lines"
msgid "Schon wieder Sie? Die Wartenummern-Anzeige glüht. Bitte weitermachen."
msgstr ""

#. max 110
#. tag sd_show_success, voice mod
#: data/stempel/lines.json:sdl_show_success_01.text
msgctxt "stempel.lines"
msgid "Ein Stempel wie ein Donnerschlag! Das kommt in die Jahresrückschau."
msgstr ""

#. max 110
#. tag sd_show_success, voice mod
#: data/stempel/lines.json:sdl_show_success_02.text
msgctxt "stempel.lines"
msgid "SHOW-KARTE geglückt! Liebes Publikum, liebe Ablagefächer: Das ist Quote."
msgstr ""

#. max 110
#. tag sd_show_fail, voice mod
#: data/stempel/lines.json:sdl_show_fail_01.text
msgctxt "stempel.lines"
