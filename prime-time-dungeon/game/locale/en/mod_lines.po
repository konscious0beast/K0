#. max 110
#. tag twist_applied_tw_elite_guest, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_elite_guest_01.text
msgctxt "mod_lines"
msgid "Wir haben einen Stargast! Er ist stärker, eitler und gibt mehr Beute."
msgstr ""

#. max 110
#. tag twist_applied_tw_double_trouble, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_double_trouble_01.text
msgctxt "mod_lines"
msgid "Doppelte Quote! Ein Gegner mehr, mehr Beute. Mathe kann so schön sein."
