#. max 110
#. tag timer_warn_60, voice mod
#: data/mod_lines.json:mod_timer_warn_60_03.text
msgctxt "mod_lines"
msgid "Letzte Minute! Der Graf sollte jetzt nicht stehen bleiben, um zu posieren."
msgstr ""

#. max 110
#. tag timer_expired, voice mod
#: data/mod_lines.json:mod_timer_expired_01.text
msgctxt "mod_lines"
msgid "Und … Sendeschluss. Die Etage ist eingestürzt. Mit Ihnen darin. Schade."
msgstr ""

#. max 110
#. tag timer_expired, voice mod
#: data/mod_lines.json:mod_timer_expired_02.text
msgctxt "mod_lines"
msgid "Zeit abgelaufen. Ich hatte Sie wirklich gemocht. Bisschen."
msgstr ""

#. max 110
#. tag lootbox_open_bronze, voice mod
#: data/mod_lines.json:mod_lootbox_open_bronze_01.text
msgctxt "mod_lines"
msgid "Bronze. Wie die Medaille für ‚Dabei sein ist alles‘."
msgstr ""

#. max 110
#. tag lootbox_open_bronze, voice mod
#: data/mod_lines.json:mod_lootbox_open_bronze_02.text
msgctxt "mod_lines"
msgid "Eine Bronzebox! Was drin ist? Wahrscheinlich ein Pflaster. Mit Werbung."
msgstr ""

#. max 110
#. tag lootbox_open_bronze, voice mod
#: data/mod_lines.json:mod_lootbox_open_bronze_03.text
msgctxt "mod_lines"
msgid "Bronze! Die Box, die sagt: ‚Wir haben an dich gedacht. Kurz.‘"
msgstr ""

#. max 110
#. tag lootbox_open_silver, voice mod
#: data/mod_lines.json:mod_lootbox_open_silver_01.text
msgctxt "mod_lines"
msgid "Silber! Jetzt wird’s interessant. Ein bisschen."
msgstr ""

#. max 110
#. tag lootbox_open_silver, voice mod
#: data/mod_lines.json:mod_lootbox_open_silver_02.text
msgctxt "mod_lines"
msgid "Silberbox! Garantiert mindestens selten. Steht so im Vertrag."
msgstr ""

#. max 110
#. tag lootbox_open_gold, voice mod
#: data/mod_lines.json:mod_lootbox_open_gold_01.text
msgctxt "mod_lines"
msgid "GOLD! Bitte Trommelwirbel. Den teuren!"
msgstr ""

#. max 110
#. tag lootbox_open_gold, voice mod
#: data/mod_lines.json:mod_lootbox_open_gold_02.text
msgctxt "mod_lines"
msgid "Eine Goldbox. Der Konzern hat dafür einen Mond verkauft."
msgstr ""

#. max 110
#. tag lootbox_open_fan, voice mod
#: data/mod_lines.json:mod_lootbox_open_fan_01.text
msgctxt "mod_lines"
msgid "Ein Fanpost-Paket! Ihre Fans haben zusammengelegt. Ein paar haben Glitzer reingetan. Sorry."
msgstr ""

#. max 110
#. tag lootbox_open_fan, voice mod
#: data/mod_lines.json:mod_lootbox_open_fan_02.text
msgctxt "mod_lines"
msgid "Von Fans, für Fans, gegen Monster. Rührend."
msgstr ""

#. max 110
#. tag lootbox_pity, voice mod
#: data/mod_lines.json:mod_lootbox_pity_01.text
msgctxt "mod_lines"
msgid "Endlich Glück! Und nein, das ist kein Algorithmus. Doch, ist es. Egal!"
msgstr ""

#. max 110
#. tag death, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_death_01.text
msgctxt "mod_lines"
msgid "Sendeschluss. {name} und der Graf sind gefallen. Wiederholung um 3 Uhr nachts."
msgstr ""

#. max 110
#. tag death, voice mod
#: data/mod_lines.json:mod_death_02.text
msgctxt "mod_lines"
msgid "Game Over. Die Zuschauer schalten ab. Ich schalte … noch nicht ab."
msgstr ""

#. max 110
#. tag death, voice mod
#: data/mod_lines.json:mod_death_03.text
msgctxt "mod_lines"
msgid "Das war’s. Ich lege Ihnen eine Blume aufs Inventar."
msgstr ""

#. max 110
#. tag mopsula_ko, voice mod
#: data/mod_lines.json:mod_mopsula_ko_01.text
msgctxt "mod_lines"
msgid "DER GRAF IST GEFALLEN! Die Quote stürzt ab! Helfen Sie ihm, sofort!"
msgstr ""

#. max 110
#. tag mopsula_ko, voice mod
#: data/mod_lines.json:mod_mopsula_ko_02.text
msgctxt "mod_lines"
msgid "Unser Graf liegt am Boden. Ich verlange eine Wiederbelebung, aus rein geschäftlichen Gründen."
msgstr ""

#. max 110
#. tag kai_ko, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_kai_ko_01.text
msgctxt "mod_lines"
msgid "{name} ist KO! Der Graf ist jetzt allein. Das wird … aristokratisch."
msgstr ""

#. max 110
#. tag kai_ko, voice mod
#: data/mod_lines.json:mod_kai_ko_02.text
msgctxt "mod_lines"
msgid "Kandidat:in am Boden. Der Mops übernimmt. Endlich ein Profi."
msgstr ""

#. max 110
#. tag revive, voice mod
#: data/mod_lines.json:mod_revive_01.text
msgctxt "mod_lines"
msgid "Wiederbelebt! Comebacks sind unser Lieblingsgenre."
msgstr ""

#. max 110
#. tag boss_intro:enm_boss_hausmeister, voice mod
#: data/mod_lines.json:mod_boss_intro_enm_boss_hausmeister_01.text
msgctxt "mod_lines"
msgid "Applaus für den Hausmeister! Seit 34 Jahren im Dienst, seit 34 Minuten ein Monster."
msgstr ""

#. max 110
#. tag boss_intro:enm_boss_hausmeister, voice mod
#: data/mod_lines.json:mod_boss_intro_enm_boss_hausmeister_02.text
msgctxt "mod_lines"
msgid "Achtung: Er hat einen Schlüssel für alles. Außer für Gnade."
msgstr ""

#. max 110
#. tag boss_phase:enm_boss_hausmeister:2, voice mod
#: data/mod_lines.json:mod_boss_phase_enm_boss_hausmeister_2_01.text
msgctxt "mod_lines"
msgid "Er verliest die Hausordnung! Paragraf sieben! Das wird hässlich."
msgstr ""

#. max 110
#. tag boss_phase:enm_boss_hausmeister:3, voice mod
#: data/mod_lines.json:mod_boss_phase_enm_boss_hausmeister_3_01.text
msgctxt "mod_lines"
msgid "Feierabend! Und ein Hausmeister im Feierabend kennt keine Regeln mehr!"
msgstr ""

#. max 110
#. tag boss_intro:enm_boss_rattenkoenigin, voice mod
#: data/mod_lines.json:mod_boss_intro_enm_boss_rattenkoenigin_01.text
msgctxt "mod_lines"
msgid "Ihre Majestät, die Rattenkönigin von Gleis 9! Sieben Ratten, ein Knoten, null Humor."
