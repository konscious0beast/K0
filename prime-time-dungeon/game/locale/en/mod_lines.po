#. max 110
#. tag casting_combo:spc_kai_neonfalter, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_kai_neonfalter_01.text
msgctxt "mod_lines"
msgid "Neonfalter! Sie leuchten jetzt. Bitte nicht zu nah an die Scheinwerfer."
msgstr ""

#. max 110
#. tag casting_combo:spc_kai_pilzling, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_kai_pilzling_01.text
msgctxt "mod_lines"
msgid "Pilzling! Gift schmeckt Ihnen jetzt nach Waldboden. Die Kantine notiert das."
msgstr ""

#. max 110
#. tag casting_combo:spc_kai_teilautomat, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_kai_teilautomat_01.text
msgctxt "mod_lines"
msgid "Teilautomat! Münzschlitz in der Brust. Bitte keine Knöpfe einwerfen, auch nicht im Scherz."
msgstr ""

#. max 110
#. tag casting_combo:spc_mop_glutmops, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_mop_glutmops_01.text
msgctxt "mod_lines"
msgid "Glutmops! Der Graf glüht jetzt auch außen. Die Requisite stellt einen Feuerlöscher bereit."
msgstr ""

#. max 110
#. tag casting_combo:spc_mop_spukmops, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_mop_spukmops_01.text
msgctxt "mod_lines"
msgid "Spukmops! Halb durchsichtig, voll überzeugt. Das Licht-Team weiß nicht, wohin damit."
msgstr ""

#. max 110
#. tag casting_combo:spc_mop_flattermops, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_mop_flattermops_01.text
msgctxt "mod_lines"
msgid "Flattermops! Winzige Flügel, große Pläne. Gelandet wird bisher nur auf Kissen."
msgstr ""

#. max 110
#. tag casting_combo:spc_kai_kachelgolem:cls_kai_wrecker, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_kai_kachelgolem_cls_kai_wrecker_01.text
msgctxt "mod_lines"
msgid "Ein Bauprojekt auf zwei Beinen. Die Statik nickt."
msgstr ""

#. max 110
#. tag casting_combo:spc_kai_neonfalter:cls_kai_runner, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_kai_neonfalter_cls_kai_runner_01.text
msgctxt "mod_lines"
msgid "Ein Neonfalter auf Gleisen. Sie leuchten schneller, als die Anzeigetafel umschalten kann."
msgstr ""

#. max 110
#. tag casting_combo:spc_kai_neonfalter:cls_kai_showrunner, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_kai_neonfalter_cls_kai_showrunner_01.text
msgctxt "mod_lines"
msgid "Leuchtende Showrunner:in! Die Kamera muss Sie nicht einmal mehr suchen."
msgstr ""

#. max 110
#. tag casting_combo:spc_kai_pilzling:cls_kai_wrecker, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_kai_pilzling_cls_kai_wrecker_01.text
msgctxt "mod_lines"
msgid "Pilzling mit Abrissbirne. Wo Sie zuschlagen, wächst danach etwas. Ökologisch wertvoll."
msgstr ""

#. max 110
#. tag casting_combo:spc_kai_pilzling:cls_kai_showrunner, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_kai_pilzling_cls_kai_showrunner_01.text
msgctxt "mod_lines"
msgid "Ein Pilzling im Rampenlicht. Sporen glitzern im Gegenlicht. Wussten Sie nicht? Jetzt schon."
msgstr ""

#. max 110
#. tag casting_combo:spc_kai_teilautomat:cls_kai_tinker, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_kai_teilautomat_cls_kai_tinker_01.text
msgctxt "mod_lines"
msgid "Teilautomat und Schrott-Tüftler:in. Sie reparieren sich jetzt selbst. Theoretisch."
msgstr ""

#. max 110
#. tag casting_combo:spc_mop_glutmops:cls_mop_archmage, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_mop_glutmops_cls_mop_archmage_01.text
msgctxt "mod_lines"
msgid "Glutmops und Erzmagister. Der Graf nennt es Feuerwerk. Die Versicherung nennt es anders."
msgstr ""

#. max 110
#. tag casting_combo:spc_mop_spukmops:cls_mop_hexer, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_mop_spukmops_cls_mop_hexer_01.text
msgctxt "mod_lines"
msgid "Ein spukender Fluchgraf. Die Akten verschwinden jetzt von selbst. Mit Fußnote."
msgstr ""

#. max 110
#. tag casting_combo:spc_mop_spukmops:cls_mop_zeremonienmeister, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_mop_spukmops_cls_mop_zeremonienmeister_01.text
msgctxt "mod_lines"
msgid "Spukmops als Zeremonienmeister. Die Mitternachtsgala hat endlich ihr Gespenst."
msgstr ""

#. max 110
#. tag casting_combo:spc_mop_flattermops:cls_mop_physician, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_mop_flattermops_cls_mop_physician_01.text
msgctxt "mod_lines"
msgid "Flattermops und Medicus. Hausbesuche jetzt per Luftpost."
msgstr ""

#. max 110
#. tag casting_combo:spc_mop_flattermops:cls_mop_zeremonienmeister, voice mod
#: data/mod_lines.json:mod_casting_combo_spc_mop_flattermops_cls_mop_zeremonienmeister_01.text
msgctxt "mod_lines"
msgid "Flattermops als Zeremonienmeister. Der Abend wird jetzt von oben eröffnet."
msgstr ""

#. max 110
#. tag casting_redo, voice mod
#: data/mod_lines.json:mod_casting_redo_01.text
msgctxt "mod_lines"
msgid "Umentscheiden? In diesem Raum ist alles noch offen. Draußen gilt: Vertrag ist Vertrag."
msgstr ""

#. max 110
#. tag casting_retrain, voice mod
#: data/mod_lines.json:mod_casting_retrain_01.text
msgctxt "mod_lines"
msgid "Umschulung! Einmal je Etage, kostenlos, im ersten Safe Room. Die Spezies bleibt, wie sie ist."
msgstr ""

#. max 110
#. tag casting_done, voice mod
#: data/mod_lines.json:mod_casting_done_01.text
msgctxt "mod_lines"
msgid "Fertig! Entschieden haben Sie. Ich habe nur genickt."
msgstr ""

#. max 110
#. tag casting_done, voice mod
#: data/mod_lines.json:mod_casting_done_02.text
msgctxt "mod_lines"
msgid "Das war der Recall. Die Kostüme sitzen, die Kamera läuft. Weiter geht's."
msgstr ""

#. max 110
#. tag casting_later, voice mod
#: data/mod_lines.json:mod_casting_later_01.text
msgctxt "mod_lines"
msgid "Kein Stress. Der Recall wartet in jedem Safe Room dieser Etage. Die Jury hat Zeit. Gerade so."
msgstr ""

#. max 110
#. tag casting_no_net, voice mod
#: data/mod_lines.json:mod_casting_no_net_01.text
msgctxt "mod_lines"
msgid "Ohne Netz ist frei: Ein Leben. Keine Rettung. Das Publikum liebt das. Sie hoffentlich auch."
