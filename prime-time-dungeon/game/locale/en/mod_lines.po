msgid "Ein anonymer Fan schickt Grüße. Die Marketingabteilung ist neidisch auf so viel Zurückhaltung."
msgstr ""

#. max 110
#. tag gift_diminished, voice mod
#. {pct} = a percentage
#: data/mod_lines.json:mod_gift_diminished_01.text
msgctxt "mod_lines"
msgid "Wirkung dieses Geschenks: {pct} Prozent. Das Regelwerk will es so. Ich habe es nicht geschrieben. Leider."
msgstr ""

#. max 110
#. tag gift_capped, voice mod
#: data/mod_lines.json:mod_gift_capped_01.text
msgctxt "mod_lines"
msgid "Geschenk-Kontingent für diesen Lauf erreicht. Das Publikum bleibt trotzdem das Beste an dieser Sendung."
msgstr ""

#. max 110
#. tag gift_declined, voice mod
#: data/mod_lines.json:mod_gift_declined_01.text
msgctxt "mod_lines"
msgid "Abgelehnt. Kandidat:innen dürfen das. Steht auf Seite 412 der Teilnahmebedingungen, gleich neben ‚Überleben‘."
msgstr ""

#. max 110
#. tag fan_pack_received, voice mod
#. {sender} = a viewer's name
#: data/mod_lines.json:mod_fan_pack_received_01.text
msgctxt "mod_lines"
msgid "Ein Applaus-Paket von {sender}. Echte Begeisterung — die Aktionäre wissen nicht, wie man die bilanziert."
msgstr ""

#. max 110
#. tag live_closing, voice mod
#. {min} = a number of minutes
#: data/mod_lines.json:mod_live_closing_01.text
msgctxt "mod_lines"
msgid "Noch {min} Minuten bis Sendeschluss. Danach geht hier das Licht aus. Und die Etage."
msgstr ""

#. max 110
#. tag vote_open, voice mod
#: data/mod_lines.json:mod_vote_open_01.text
msgctxt "mod_lines"
msgid "Das Publikum entscheidet! Demokratie, aber mit Werbeunterbrechung."
msgstr ""

#. max 110
#. tag sponsor_window_open, voice mod
#: data/mod_lines.json:mod_sponsor_window_open_01.text
msgctxt "mod_lines"
msgid "Das Sponsor-Fenster ist offen. Wer helfen mag, hilft. Wer zuschaut, zählt genauso."
msgstr ""

#. max 110
#. tag sponsor_window_open, voice mod
#: data/mod_lines.json:mod_sponsor_window_open_02.text
msgctxt "mod_lines"
msgid "Das Sponsor-Fenster steht offen. Helfen ist freiwillig, Zuschauen zählt genauso. Nur Zugluft ist Pflicht."
msgstr ""

#. max 110
#. tag sponsor_window_open:safe_room, voice mod
#: data/mod_lines.json:mod_sponsor_window_open_safe_room_01.text
msgctxt "mod_lines"
msgid "Werbepause mit Sponsor-Fenster. Wer nur zuschaut, macht auch alles richtig."
msgstr ""

#. max 110
#. tag sponsor_window_open:boss, voice mod
#: data/mod_lines.json:mod_sponsor_window_open_boss_01.text
msgctxt "mod_lines"
msgid "Vor dem Boss öffnet das Sponsor-Fenster. Danach entscheiden Können und Glück. Vor allem Glück."
msgstr ""

#. max 110
#. tag sponsor_window_open:boss_comeback, voice mod
#: data/mod_lines.json:mod_sponsor_window_open_boss_comeback_01.text
msgctxt "mod_lines"
msgid "Comeback-Runde! Das Sponsor-Fenster öffnet noch einmal. Das Publikum glaubt an Sie. Ich auch, fast."
msgstr ""

#. max 110
#. tag sponsor_window_closed, voice mod
#: data/mod_lines.json:mod_sponsor_window_closed_01.text
msgctxt "mod_lines"
msgid "Sponsor-Fenster zu. Die Regie nennt das Programmstruktur. Ich nenne es: Durchzug verhindern."
msgstr ""

#. max 110
#. tag sponsor_window_closed, voice mod
#: data/mod_lines.json:mod_sponsor_window_closed_02.text
msgctxt "mod_lines"
msgid "Fenster geschlossen. Mitfiebern bleibt erlaubt – das hat die Rechtsabteilung noch nicht entdeckt."
msgstr ""

#. max 110
#. tag sponsor_window_full, voice mod
#: data/mod_lines.json:mod_sponsor_window_full_01.text
msgctxt "mod_lines"
msgid "Alle Plätze im Sponsor-Fenster sind belegt. Danke – auch dem stillen Publikum. Das zählt hier am meisten."
msgstr ""

#. max 110
#. tag tutorial_explore, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_tutorial_explore_01.text
msgctxt "mod_lines"
msgid "Willkommen in der Unterstadt, {name}! Laufen Sie los – die Kamera dreht sich, wenn Sie sie lassen."
msgstr ""

#. max 110
#. tag tutorial_sneak, voice mod
#: data/mod_lines.json:mod_tutorial_sneak_01.text
msgctxt "mod_lines"
msgid "Da vorn schlafen zwei Ratten. Schleichen Sie sich an und schlagen Sie zuerst zu – dann fangen Sie an."
msgstr ""

#. max 110
#. tag tutorial_battle, voice mod
#: data/mod_lines.json:mod_tutorial_battle_01.text
msgctxt "mod_lines"
msgid "Zuschlagen kostet nichts. Mopsulas Adelsflamme kostet MP – und Ratten hassen Feuer. Fast so sehr wie Steuern."
msgstr ""

#. max 110
#. tag story_battle:enc_f1_b2, voice mod
#: data/mod_lines.json:mod_story_battle_enc_f1_b2_01.text
msgctxt "mod_lines"
msgid "Die Königin hört von euch."
msgstr ""

#. max 110
#. tag twist_applied_tw_lights_out, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_lights_out_01.text
msgctxt "mod_lines"
msgid "Stromausfall! Sparmaßnahme der Regie. Die Monster sehen auch nichts. Fair, oder?"
msgstr ""

#. max 110
#. tag twist_applied_tw_lights_out, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_lights_out_02.text
msgctxt "mod_lines"
msgid "Licht aus, Spannung an. Die Gegner tappen im Dunkeln. Sie bitte nicht zu laut."
msgstr ""

#. max 110
#. tag twist_applied_tw_quiet_please, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_quiet_please_01.text
msgctxt "mod_lines"
msgid "Ruhe im Studio! Die Monster hören jetzt schlechter. Flüstern Sie trotzdem, es ist höflich."
msgstr ""

#. max 110
#. tag twist_applied_tw_quiet_please, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_quiet_please_02.text
msgctxt "mod_lines"
msgid "Die Tonabteilung dreht alles leiser. Ideale Bedingungen zum Anschleichen."
msgstr ""

#. max 110
#. tag twist_applied_tw_fog_of_fame, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_fog_of_fame_01.text
msgctxt "mod_lines"
msgid "Ruhmesnebel! Das Publikum vergisst gerade nichts. Nutzen Sie das."
msgstr ""

#. max 110
#. tag twist_applied_tw_fog_of_fame, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_fog_of_fame_02.text
msgctxt "mod_lines"
msgid "Die Regie hält die Quote fest. Ihr Hype sinkt eine Weile nicht. Gern geschehen."
msgstr ""

#. max 110
#. tag twist_applied_tw_confetti_gravity, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_confetti_gravity_01.text
msgctxt "mod_lines"
msgid "Konfetti-Gravitation! Es schneit nach oben. Die Physikabteilung ist im Urlaub."
msgstr ""

#. max 110
#. tag twist_applied_tw_confetti_gravity, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_confetti_gravity_02.text
msgctxt "mod_lines"
msgid "Konfetti fällt heute nach oben. Der Hype übrigens auch nicht nach unten."
msgstr ""

#. max 110
#. tag twist_applied_tw_double_credits, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_double_credits_01.text
msgctxt "mod_lines"
msgid "Doppel-Credits für eine Minute! Danach ist die Inflation wieder normal."
msgstr ""

#. max 110
#. tag twist_applied_tw_double_credits, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_double_credits_02.text
msgctxt "mod_lines"
msgid "Die Buchhaltung hat sich verrechnet. Zu Ihren Gunsten. Bitte nicht weitersagen."
msgstr ""

#. max 110
#. tag twist_applied_tw_overtime, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_overtime_01.text
msgctxt "mod_lines"
msgid "Nachspielzeit! Eine Minute extra. Ich bin heute großzügig. Notieren Sie das."
msgstr ""

#. max 110
#. tag twist_applied_tw_overtime, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_overtime_02.text
msgctxt "mod_lines"
msgid "Die Uhr bekommt eine Verlängerung. Werbekunden zahlen ja nach Minuten."
msgstr ""

#. max 110
#. tag twist_applied_tw_happy_hour, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_happy_hour_01.text
msgctxt "mod_lines"
msgid "Happy Hour am Automaten! Rabatt beim nächsten Safe Room. Der Automat weint leise."
msgstr ""

#. max 110
#. tag twist_applied_tw_happy_hour, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_happy_hour_02.text
msgctxt "mod_lines"
msgid "Der nächste Automat hat Happy Hour. Er weiß es nur noch nicht."
msgstr ""

#. max 110
#. tag twist_applied_tw_rat_rain, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_rat_rain_01.text
msgctxt "mod_lines"
msgid "Rattenregen! Ein Lieferant hatte zu viel Lagerbestand. Ich konnte nicht Nein sagen."
msgstr ""

#. max 110
#. tag twist_applied_tw_rat_rain, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_rat_rain_02.text
msgctxt "mod_lines"
msgid "Neue Kandidaten im Gebäude. Pelzig, hungrig, nicht eingeladen. Viel Spaß."
msgstr ""

#. max 110
#. tag twist_applied_tw_party_hats, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_party_hats_01.text
msgctxt "mod_lines"
msgid "Partyhüte für alle Monster! Die nächsten zwei Kämpfe sind offiziell eine Feier."
msgstr ""

#. max 110
#. tag twist_applied_tw_party_hats, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_party_hats_02.text
msgctxt "mod_lines"
msgid "Die Gegner tragen jetzt Partyhüte. Das Publikum flippt aus. Ich auch, innerlich."
msgstr ""

#. max 110
#. tag twist_applied_tw_mopsula_moderates, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_mopsula_moderates_01.text
msgctxt "mod_lines"
msgid "Ich mache Pause. Der Graf moderiert. Möge die Sendung das überleben."
msgstr ""

#. max 110
#. tag twist_applied_tw_mopsula_moderates, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_mopsula_moderates_02.text
msgctxt "mod_lines"
msgid "Kurze Moderationspause. Der Graf hat das Mikro. Gott steh der Technik bei."
msgstr ""

#. max 110
#. tag twist_applied_tw_mopsula_monologue, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_mopsula_monologue_01.text
msgctxt "mod_lines"
msgid "Der Graf hat um das Wort gebeten. Ich habe es ihm gegeben. Ich bereue es schon."
msgstr ""

#. max 110
#. tag twist_applied_tw_mod_mood, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_mod_mood_01.text
msgctxt "mod_lines"
msgid "Ich wechsle die Stimmung. Bitte schnallen Sie sich an."
msgstr ""

#. max 110
#. tag twist_applied_tw_costume, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_costume_01.text
msgctxt "mod_lines"
msgid "Kostümwechsel beim Grafen! Die Garderobe hat Überstunden gemacht."
msgstr ""

#. max 110
#. tag twist_applied_tw_trap_or_treasure, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_trap_or_treasure_01.text
msgctxt "mod_lines"
msgid "Im nächsten Raum steht eine Kiste. Falle oder Schatz? Ich verrate nichts."
msgstr ""

#. max 110
#. tag twist_applied_tw_mirror_room, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_mirror_room_01.text
msgctxt "mod_lines"
msgid "Spiegel-Raum! Was eben noch wehtat, kitzelt jetzt. Und umgekehrt."
