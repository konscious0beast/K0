#. max 110
#. tag regie_monologue_3, voice mopsula
#: data/mod_lines.json:mod_regie_monologue_3_01.text
msgctxt "mod_lines"
msgid "Und nun zurück zu meiner Assistentin. Sie ist ein Fernseher. Ich respektiere das."
msgstr ""

#. max 110
#. tag regie_monologue_3, voice mopsula
#: data/mod_lines.json:mod_regie_monologue_3_02.text
msgctxt "mod_lines"
msgid "Applaus ist erlaubt. Leberwurst ebenfalls. Danke, das war alles."
msgstr ""

#. max 110
#. tag mod_live_on, voice mod
#: data/mod_lines.json:mod_mod_live_on_01.text
msgctxt "mod_lines"
msgid "M.O.D. live ist auf Sendung. Ab jetzt improvisiere ich. Die Rechtsabteilung schwitzt."
msgstr ""

#. max 110
#. tag rt_set_quiet, voice mod
#: data/mod_lines.json:mod_rt_set_quiet_01.text
msgctxt "mod_lines"
msgid "Ruhe am Set! Kamera läuft, Monster auf Position, Sie auf eigene Gefahr."
msgstr ""

#. max 110
#. tag rt_set_quiet, voice mod
#: data/mod_lines.json:mod_rt_set_quiet_02.text
msgctxt "mod_lines"
msgid "Ruhe am Set! Ihr seid später dran."
msgstr ""

#. max 110
#. tag rt_flee_warn, voice mod
#: data/mod_lines.json:mod_rt_flee_warn_01.text
msgctxt "mod_lines"
msgid "Wo willst du hin? Das Set ist HIER!"
msgstr ""

#. max 110
#. tag rt_flee_warn, voice mod
#: data/mod_lines.json:mod_rt_flee_warn_02.text
msgctxt "mod_lines"
msgid "Zurück ans Set! Im Flur filmt keine Kamera."
msgstr ""

#. max 110
#. tag rt_interrupt, voice mod
#: data/mod_lines.json:mod_rt_interrupt_01.text
msgctxt "mod_lines"
msgid "Und da wird ihm das Wort abgeschnitten — live und in Farbe!"
msgstr ""

#. max 110
#. tag rt_interrupt, voice mod
#: data/mod_lines.json:mod_rt_interrupt_02.text
msgctxt "mod_lines"
msgid "Unterbrochen! Die Regie dankt für die Kürzung."
msgstr ""

#. max 110
#. tag rt_dodge_close, voice mod
#: data/mod_lines.json:mod_rt_dodge_close_01.text
msgctxt "mod_lines"
msgid "Zentimeterarbeit! Unsere Versicherung atmet auf."
msgstr ""

#. max 110
#. tag rt_dodge_close, voice mod
#: data/mod_lines.json:mod_rt_dodge_close_02.text
msgctxt "mod_lines"
msgid "Knapp! Die Stuntkoordination nimmt das ins Showreel."
msgstr ""

#. max 110
#. tag rt_telegraph_hit, voice mod
#: data/mod_lines.json:mod_rt_telegraph_hit_01.text
msgctxt "mod_lines"
msgid "Rote Fläche, rote Zahlen. Die Warnung lief ja nur zwei Sekunden."
msgstr ""

#. max 110
#. tag rt_telegraph_hit, voice mod
#: data/mod_lines.json:mod_rt_telegraph_hit_02.text
msgctxt "mod_lines"
msgid "Volltreffer — leider für die Gegenseite. Die Fläche war wirklich sehr rot."
msgstr ""

#. max 110
#. tag rt_train_kill, voice mod
#: data/mod_lines.json:mod_rt_train_kill_01.text
msgctxt "mod_lines"
msgid "Bitte zurückbleiben! … Zu spät."
msgstr ""

#. max 110
#. tag rt_train_kill, voice mod
#: data/mod_lines.json:mod_rt_train_kill_02.text
msgctxt "mod_lines"
msgid "Der Zug hält nicht für Ratten. Fahrplanmäßig."
msgstr ""

#. max 110
#. tag rt_healer_first, voice mod
#: data/mod_lines.json:mod_rt_healer_first_01.text
msgctxt "mod_lines"
msgid "Heiler zuerst! Wer heilt, verlängert die Sendung — und nicht im guten Sinn."
msgstr ""

#. max 110
#. tag rt_healer_first, voice mod
#: data/mod_lines.json:mod_rt_healer_first_02.text
msgctxt "mod_lines"
msgid "Der Schamane flickt seine Kollegen. Unterbrechen oder ewig zuschauen!"
msgstr ""

#. max 110
#. tag rt_finale, voice mod
#: data/mod_lines.json:mod_rt_finale_01.text
msgctxt "mod_lines"
msgid "Das FINALE! Kamera drei, ganz nah ran!"
msgstr ""

#. max 110
#. tag rt_finale, voice mod
#: data/mod_lines.json:mod_rt_finale_02.text
msgctxt "mod_lines"
msgid "FINALE! Ich lasse schon mal den Abspann vorwärmen."
msgstr ""

#. max 110
#. tag rt_finale_hype, voice mod
#: data/mod_lines.json:mod_rt_finale_hype_01.text
msgctxt "mod_lines"
msgid "FINALE bei Höchstquote! Konfettikanone, JETZT!"
msgstr ""

#. max 110
#. tag rt_finale_hype, voice mod
#: data/mod_lines.json:mod_rt_finale_hype_02.text
msgctxt "mod_lines"
msgid "Das Publikum steht, die Regie weint, das FINALE läuft. Mehr Fernsehen geht nicht."
msgstr ""

#. max 110
#. tag rt_enrage:enm_boss_hausmeister, voice mod
#: data/mod_lines.json:mod_rt_enrage_enm_boss_hausmeister_01.text
msgctxt "mod_lines"
msgid "Es ist 17 Uhr. Ab jetzt macht der Hausmeister Überstunden — an euch."
msgstr ""

#. max 110
#. tag rt_enrage:enm_boss_hausmeister, voice mod
#: data/mod_lines.json:mod_rt_enrage_enm_boss_hausmeister_02.text
msgctxt "mod_lines"
msgid "Feierabend ist Feierabend! Und der Hausmeister nimmt ihn SEHR ernst."
msgstr ""

#. max 110
#. tag rt_enrage:enm_boss_rattenkoenigin, voice mod
#: data/mod_lines.json:mod_rt_enrage_enm_boss_rattenkoenigin_01.text
msgctxt "mod_lines"
msgid "Betriebsschluss! Die Königin räumt den Bahnsteig — mit euch."
msgstr ""

#. max 110
#. tag rt_enrage:enm_boss_rattenkoenigin, voice mod
#: data/mod_lines.json:mod_rt_enrage_enm_boss_rattenkoenigin_02.text
msgctxt "mod_lines"
msgid "Letzte Durchsage vor Betriebsschluss: Die Königin ist schlecht gelaunt."
msgstr ""

#. max 110
#. tag rt_control_switch:kai, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_rt_control_switch_kai_01.text
msgctxt "mod_lines"
msgid "Der Graf liegt flach. {name} übernimmt — mit Mopp und Würde."
msgstr ""

#. max 110
#. tag rt_control_switch:kai, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_rt_control_switch_kai_02.text
msgctxt "mod_lines"
msgid "Der Graf ruht. {name}, das Publikum gehört jetzt dir."
msgstr ""

#. max 110
#. tag rt_control_switch:mopsula, voice mod
#: data/mod_lines.json:mod_rt_control_switch_mopsula_01.text
msgctxt "mod_lines"
msgid "Der Graf übernimmt. Möge die Etikette mit uns sein."
msgstr ""

#. max 110
#. tag rt_control_switch:mopsula, voice mod
#. {name} = the candidate's name, e.g. Kai
#: data/mod_lines.json:mod_rt_control_switch_mopsula_02.text
msgctxt "mod_lines"
msgid "{name} liegt flach. Der Graf übernimmt — mit Monokel und Methode."
msgstr ""

#. max 110
#. tag rt_partner_preset:attack, voice mod
#: data/mod_lines.json:mod_rt_partner_preset_attack_01.text
msgctxt "mod_lines"
msgid "Taktik „Angriff“. Höflichkeit wird auf nach der Sendung verschoben."
msgstr ""

#. max 110
#. tag rt_partner_preset:support, voice mod
#: data/mod_lines.json:mod_rt_partner_preset_support_01.text
msgctxt "mod_lines"
msgid "Taktik „Unterstützen“. Teamarbeit — das Lieblingswort jeder Personalabteilung."
msgstr ""

#. max 110
#. tag rt_partner_preset:careful, voice mod
#: data/mod_lines.json:mod_rt_partner_preset_careful_01.text
msgctxt "mod_lines"
msgid "Taktik „Vorsichtig“. Mehr Abstand, schnellere Reaktion. Die Versicherung schickt Blumen."
msgstr ""

#. max 110
#. tag rt_tutorial_target, voice mod
#: data/mod_lines.json:mod_rt_tutorial_target_01.text
msgctxt "mod_lines"
msgid "Wähle ein Ziel. Die Kamera liebt Entschlossenheit."
msgstr ""

#. max 110
#. tag rt_tutorial_bar1, voice mod
#: data/mod_lines.json:mod_rt_tutorial_bar1_01.text
msgctxt "mod_lines"
msgid "Deine Hauptfähigkeit! Oft drücken ist ausdrücklich erwünscht."
msgstr ""

#. max 110
#. tag rt_tutorial_show, voice mod
#: data/mod_lines.json:mod_rt_tutorial_show_01.text
msgctxt "mod_lines"
msgid "SHOW: riskant, aber das Publikum liebt es."
msgstr ""

#. max 110
#. tag rt_tutorial_dodge, voice mod
#: data/mod_lines.json:mod_rt_tutorial_dodge_01.text
msgctxt "mod_lines"
msgid "Rote Fläche? Raus da! Wenn sie voll ist, knallt es."
