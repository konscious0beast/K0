#. max 110
#. tag casting_class, voice mod
#: data/mod_lines.json:mod_casting_class_01.text
msgctxt "mod_lines"
msgid "Und was wollen Sie können? Vier Klassen. Eine davon trägt Sie bis ins Finale. Vielleicht."
msgstr ""

#. max 110
#. tag casting_class, voice mod
#: data/mod_lines.json:mod_casting_class_02.text
msgctxt "mod_lines"
msgid "Zweite Runde: die Klasse. Umschulen geht später, einmal je Etage im ersten Safe Room."
