#. max 110
#. tag boss_phase:enm_boss_rattenkoenigin:2, voice mod
#: data/mod_lines.json:mod_boss_phase_enm_boss_rattenkoenigin_2_01.text
msgctxt "mod_lines"
msgid "Hören Sie das? Das ist der Zug auf Gleis 9. Er ist pünktlich. Zum ersten Mal überhaupt."
msgstr ""

