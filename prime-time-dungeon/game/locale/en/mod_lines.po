#. max 110
#. tag casting_class:mopsula, voice mod
#: data/mod_lines.json:mod_casting_class_mopsula_01.text
msgctxt "mod_lines"
msgid "Was soll der Graf können? Er meint: alles. Die Jury bittet um eine Klasse."
msgstr ""

#. max 110
#. tag casting_confirm, voice mod
#: data/mod_lines.json:mod_casting_confirm_01.text
msgctxt "mod_lines"
msgid "Letzte Frage der Jury: sicher? Die Spezies gilt, sobald Sie diesen Raum verlassen."
msgstr ""

#. max 110
#. tag casting_combo, voice mod
#: data/mod_lines.json:mod_casting_combo_01.text
msgctxt "mod_lines"
msgid "Notiert. Die Jury nickt. Die Jury nickt immer. Diesmal aus Überzeugung."
msgstr ""

#. max 110
#. tag casting_combo, voice mod
#: data/mod_lines.json:mod_casting_combo_02.text
msgctxt "mod_lines"
msgid "Eine mutige Kombination. Das Publikum liebt Mut. Die Statistik schaut noch skeptisch."
msgstr ""

#. max 110
#. tag casting_combo, voice mod
#: data/mod_lines.json:mod_casting_combo_03.text
msgctxt "mod_lines"
msgid "Angenommen! Ihre Fans basteln schon Schilder. Mit Glitzer, aus Liebe."
