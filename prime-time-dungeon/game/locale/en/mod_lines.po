#. tag regie_monologue_1, voice mopsula
#: data/mod_lines.json:mod_regie_monologue_1_02.text
msgctxt "mod_lines"
msgid "Ruhe bitte. Ein Graf spricht nur einmal pro Folge. Höchstens zweimal."
msgstr ""

#. max 110
#. tag regie_monologue_2, voice mopsula
#: data/mod_lines.json:mod_regie_monologue_2_01.text
msgctxt "mod_lines"
msgid "Ich habe Zwinger 7 überlebt. Diese Sendung ist dagegen ein Spaziergang."
