msgstr ""

#. max 110
#. tag boring_fight, voice mod
#: data/mod_lines.json:mod_boring_fight_02.text
msgctxt "mod_lines"
msgid "Gähn. Haben Sie es mal mit … Abwechslung versucht?"
msgstr ""

