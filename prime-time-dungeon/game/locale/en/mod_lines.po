#. max 110
#. tag twist_applied_tw_sponsor_rush, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_sponsor_rush_01.text
msgctxt "mod_lines"
msgid "Werbeblock! Unsere Sponsoren sind heute besonders spendabel."
msgstr ""

#. max 110
#. tag twist_applied_tw_boss_mood, voice mod
#: data/mod_lines.json:mod_twist_applied_tw_boss_mood_01.text
msgctxt "mod_lines"
msgid "Das Publikum hat die Laune des Bosses gewählt. Ich wasche meine Hände in Unschuld."
