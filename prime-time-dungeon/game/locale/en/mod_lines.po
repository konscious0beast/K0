#. max 110
#. tag regie_cut_in, voice mod
#: data/mod_lines.json:mod_regie_cut_in_01.text
msgctxt "mod_lines"
msgid "Die Regie greift ein. Kurz, begrenzt, meistens zu Ihren Gunsten."
msgstr ""

#. max 110
#. tag regie_cut_in, voice mod
#: data/mod_lines.json:mod_regie_cut_in_02.text
msgctxt "mod_lines"
msgid "Achtung, Regie-Eingriff! Keine Sorge, ich habe die Kontrolle. Meistens."
msgstr ""

#. max 110
#. tag regie_monologue_1, voice mopsula
#: data/mod_lines.json:mod_regie_monologue_1_01.text
msgctxt "mod_lines"
msgid "Meine Damen und Herren, Ratten und Restposten: Der Graf hat das Wort."
