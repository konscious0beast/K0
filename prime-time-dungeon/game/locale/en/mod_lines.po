#: data/scenes.json:scn_mop_1.name
msgctxt "scenes"
msgid "Fußnote 1"
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_1.lines[0].text
msgctxt "scenes"
msgid "Kolleg:in. Setz dich. Es folgt ein kurzer Vortrag. Mit Fußnoten."
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_1.lines[1].text
msgctxt "scenes"
msgid "Du redest seit einer Stunde."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_1.lines[2].text
msgctxt "scenes"
msgid "Mit dir. Nicht AN dich. Fußnote 1: ein Unterschied, den man im Grundstudium lernt."
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_1.lines[3].text
msgctxt "scenes"
msgid "Wieso kannst du überhaupt sprechen?"
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_1.lines[4].text
msgctxt "scenes"
msgid "Ich konnte immer sprechen. Ihr habt nur nie zugehört."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_1.lines[5].text
msgctxt "scenes"
msgid "Neun Jahre „Na, du Kleiner?“. Neun Jahre! Ich bin ein GRAF."
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_1.lines[6].text
msgctxt "scenes"
msgid "… Ich hab dir jeden Abend das Ohr gekrault."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_1.lines[7].text
msgctxt "scenes"
msgid "(Pause) Das linke. Das linke war akzeptabel. Weitermachen."
msgstr ""

#. max 110
#. voice mod
#: data/scenes.json:scn_mop_1.lines[8].text
msgctxt "scenes"
msgid "Zuschauer-Umfrage: 94 % wollen mehr vom Hund. Notiert."
msgstr ""

#: data/scenes.json:scn_mop_2.name
msgctxt "scenes"
msgid "Ahnenreihe"
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_2.lines[0].text
msgctxt "scenes"
msgid "Der Hausmeister. Er hatte einen Schlüssel für jede Tür."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_2.lines[1].text
msgctxt "scenes"
msgid "Und keine einzige, hinter der jemand auf ihn wartete."
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_2.lines[2].text
msgctxt "scenes"
msgid "Das ist ungewohnt nachdenklich für dich."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_2.lines[3].text
msgctxt "scenes"
msgid "Nachdenklichkeit ist erblich. Fußnote 3: Meine Ahnen waren Grafen, Gelehrte, Nachtgestalten —"
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_2.lines[4].text
msgctxt "scenes"
msgid "Laut deiner Akte wurdest du in einem Umzugskarton im Tierheim abgegeben."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_2.lines[5].text
msgctxt "scenes"
msgid "EIN SEHR VORNEHMER UMZUGSKARTON. Mit Büchern darin."
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_2.lines[6].text
msgctxt "scenes"
msgid "(lacht)"
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_2.lines[7].text
msgctxt "scenes"
msgid "… Wartet jemand auf dich? Da oben?"
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_2.lines[8].text
msgctxt "scenes"
msgid "Da oben ist nichts mehr."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_2.lines[9].text
msgctxt "scenes"
msgid "Dann warten wir eben aufeinander. Das ist keine Bitte. Das ist eine These."
msgstr ""

#: data/scenes.json:scn_mop_3.name
msgctxt "scenes"
msgid "Das Tierheim"
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_3.lines[0].text
msgctxt "scenes"
msgid "Weißt du, warum ich in Zwinger 7 „schwer vermittelbar“ war?"
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_3.lines[1].text
msgctxt "scenes"
msgid "Weil du jeden Besucher angeknurrt hast."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_3.lines[2].text
msgctxt "scenes"
msgid "Weil sie die Falschen waren. Familien mit Kinderwagen. Pärchen mit Selfie-Stab."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_3.lines[3].text
msgctxt "scenes"
msgid "Niemand wollte einen alten Mops mit Atemgeräuschen."
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_3.lines[4].text
msgctxt "scenes"
msgid "Ich wollte dich adoptieren. Nächsten Monat. Die Papiere lagen schon in der Schublade."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_3.lines[5].text
msgctxt "scenes"
msgid "(lange Pause) … Das sagst du nur wegen der Kameras."
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_3.lines[6].text
msgctxt "scenes"
msgid "Die Kameras sind mir egal."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_3.lines[7].text
msgctxt "scenes"
msgid "Hmpf. Ich nehme das zu Protokoll. Unter Vorbehalt. (dreht sich weg, Schwanz wedelt)"
msgstr ""

#. max 110
#. voice mod
#: data/scenes.json:scn_mop_3.lines[8].text
msgctxt "scenes"
msgid "Diese Szene wird in 47 Galaxien gerade mit Taschentüchern beworben. Danke."
msgstr ""

#: data/scenes.json:scn_mop_4.name
msgctxt "scenes"
msgid "Mitternacht auf Gleis 9"
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_4.lines[0].text
msgctxt "scenes"
msgid "Sie nennt sich Königin. Eine RATTE. Mit Kopfschmuck aus gelochten Fahrscheinen."
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_4.lines[1].text
msgctxt "scenes"
msgid "Wir müssen nicht gegen sie kämpfen. Die Treppe ist gleich da."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_4.lines[2].text
msgctxt "scenes"
msgid "Es gibt Dinge, die ein Graf nicht dulden kann. Fußnote 9: Hochstapelei."
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_4.lines[3].text
msgctxt "scenes"
msgid "Du bist ein Mops aus dem Tierheim."
msgstr ""

#. max 110
#. voice mopsula
#. {job} = a job in the word form, e.g. Tierpfleger:in
#: data/scenes.json:scn_mop_4.lines[4].text
msgctxt "scenes"
msgid "Und du bist {job}. Mit einem Wischmopp. Und doch stehen wir hier."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_4.lines[5].text
msgctxt "scenes"
msgid "Lebend. Im Fernsehen. Kurz vor Mitternacht."
msgstr ""

#. max 110
#. voice kai
#: data/scenes.json:scn_mop_4.lines[6].text
msgctxt "scenes"
msgid "… Okay. Zusammen."
msgstr ""

#. max 110
#. voice mopsula
#: data/scenes.json:scn_mop_4.lines[7].text
msgctxt "scenes"
msgid "Zusammen. Aber ich gehe voraus. Wegen der Optik."
msgstr ""
